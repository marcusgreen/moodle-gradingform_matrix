{{!
    @template gradingform_matrix/matrix

    The whole grading form: the criteria table, the add criterion button and the options.

    Classes required for JS:
    * gradingform_matrix, criteria, addcriterion

    Context variables required for this template:
    * id, class: the wrapper
    * tableid: the criteria table
    * criteria: rendered criteria, see gradingform_matrix/criterion
    * addcriterion: optional {name, id, value} when editing
    * options: optional, see gradingform_matrix/options

    Example context (json):
    {
        "id": "matrix-advancedgrading",
        "class": "clearfix gradingform_matrix view",
        "tableid": "advancedgrading-criteria",
        "criteria": ""
    }
}}
<div id="{{id}}" class="{{class}}">
    <div class="criteria-wrapper">
        <table class="criteria" id="{{tableid}}">
            <caption class="visually-hidden">{{#str}} gradingform, gradingform_matrix {{/str}}</caption>
            {{{criteria}}}
        </table>
    </div>
    {{#addcriterion}}
        <div class="addcriterion my-2">
            <input type="submit" name="{{name}}" id="{{id}}" class="btn btn-secondary" value="{{value}}">
        </div>
    {{/addcriterion}}
    {{#options}}
        {{> gradingform_matrix/options }}
    {{/options}}
</div>
