{{!
    @template gradingform_matrix/instances

    The graded forms of an item, followed by the content shown without advanced grading.

    Context variables required for this template:
    * hasinstances: whether there are any instances
    * instances: list of rendered instances, see gradingform_matrix/instance
    * defaultcontent: content shown without advanced grading

    Example context (json):
    {
        "hasinstances": true,
        "instances": ["<p>Instance</p>"],
        "defaultcontent": "<p>Grade: 5</p>"
    }
}}
{{#hasinstances}}
    <div class="advancedgrade">
        {{#instances}}
            {{{.}}}
        {{/instances}}
    </div>
{{/hasinstances}}
{{{defaultcontent}}}
