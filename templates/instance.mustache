{{!
    @template gradingform_matrix/instance

    One graded form, as the person graded or a grader sees it after grading.

    Context variables required for this template:
    * descriptionhtml: optional formatted description of the form
    * matrixhtml: the rendered form, see gradingform_matrix/matrix

    Example context (json):
    {
        "descriptionhtml": "<p>Form description</p>",
        "matrixhtml": ""
    }
}}
{{#descriptionhtml}}
    <div class="box py-3 gradingform_matrix-description">{{{.}}}</div>
{{/descriptionhtml}}
{{{matrixhtml}}}
