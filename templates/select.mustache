{{!
    @template gradingform_matrix/select

    A single-choice dropdown, as html_writer::select() draws it.

    Context variables required for this template:
    * id, name, class: the select element
    * options: list of {value, text, selected}

    Example context (json):
    {
        "id": "menuadvancedgradingregrade",
        "name": "advancedgrading[regrade]",
        "class": "select form-select menuadvancedgradingregrade",
        "options": [
            {"value": 0, "text": "Do not mark for regrade", "selected": false},
            {"value": 1, "text": "Mark for regrade", "selected": true}
        ]
    }
}}
<select id="{{id}}" class="{{class}}" name="{{name}}">
    {{#options}}
        <option value="{{value}}"{{#selected}} selected="selected"{{/selected}}>{{text}}</option>
    {{/options}}
</select>
