{{!
    @template gradingform_matrix/edit_actions

    The row of actions above the grading form editor: import, export, AI assistant and plugin settings.
    Lined up with the form fields below, in the second column of the form layout.

    Context variables required for this template:
    * actions: list of {label, style, url} for a link, or {label, style, action} for a button
      handled by JavaScript through its data-action; style is the Bootstrap button style

    Example context (json):
    {
        "actions": [
            {"label": "Import", "style": "btn-secondary", "url": "https://example.com/import.php"},
            {"label": "AI assistant", "style": "btn-secondary", "action": "gradingform_matrix-aiassistant"},
            {"label": "Plugin settings", "style": "btn-link", "url": "https://example.com/admin.php"}
        ]
    }
}}
<div class="row mb-3">
    <div class="col-md-9 offset-md-3 d-flex flex-wrap gap-2 gradingform_matrix-importexport">
        {{#actions}}
            {{#url}}
                <a href="{{url}}" class="btn {{style}}">{{label}}</a>
            {{/url}}
            {{^url}}
                <button type="button" class="btn {{style}}" data-action="{{action}}">{{label}}</button>
            {{/url}}
        {{/actions}}
    </div>
</div>
