{{!
    @template gradingform_matrix/ai_assistant

    Body of the AI assistant dialogue on the grading form editor.

    Context variables required for this template:
    * uniqid - Unique id for element ids
    * sources - Course material that can be read
    * canapply - Whether a proposal can replace the form

    Example context (json):
    {
        "uniqid": "ai1",
        "canapply": true,
        "sources": [
            {"cmid": 1, "name": "Essay", "type": "Assignment", "section": "Week 1", "graded": true, "length": 300},
            {"cmid": 2, "name": "Guide", "type": "Page", "section": "Week 1", "graded": false, "length": 2500}
        ]
    }
}}
<div class="gradingform_matrix-ai" data-region="gradingform_matrix-ai">
    <p class="small text-body-secondary">{{#str}} aidisclaimer, gradingform_matrix {{/str}}</p>
    <div class="row g-4">
        <div class="col-lg-5">
            <fieldset class="mb-3">
                <legend class="h6">{{#str}} aisources, gradingform_matrix {{/str}}</legend>
                {{#sources}}
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="{{cmid}}" id="{{uniqid}}-source-{{cmid}}"
                        data-length="{{length}}" data-region="ai-source" {{#graded}}checked{{/graded}}>
                    <label class="form-check-label" for="{{uniqid}}-source-{{cmid}}">
                        {{name}}
                        <span class="small text-body-secondary d-block">
                            {{section}} · {{type}} ·
                            {{#str}} aisourcelength, gradingform_matrix, {{length}} {{/str}}
                        </span>
                    </label>
                </div>
                {{/sources}}
                {{^sources}}
                <p class="small text-body-secondary">{{#str}} aisourcesnone, gradingform_matrix {{/str}}</p>
                {{/sources}}
                <p class="small mt-2 mb-0" data-region="ai-size" aria-live="polite"></p>
            </fieldset>

            <h3 class="h6" id="{{uniqid}}-log-heading">{{#str}} aiconversation, gradingform_matrix {{/str}}</h3>
            <div class="gradingform_matrix-ai-log border rounded p-2 mb-2" role="log" aria-live="polite"
                aria-labelledby="{{uniqid}}-log-heading" tabindex="0" data-region="ai-log">
                <p class="small text-body-secondary mb-0" data-region="ai-empty">{{#str}} aiconversationempty, gradingform_matrix {{/str}}</p>
            </div>

            <form data-region="ai-form">
                <label class="form-label" for="{{uniqid}}-instruction">{{#str}} aiinstruction, gradingform_matrix {{/str}}</label>
                <textarea class="form-control" id="{{uniqid}}-instruction" rows="3" maxlength="2000"
                    data-region="ai-instruction" aria-describedby="{{uniqid}}-instruction-help"></textarea>
                <div class="form-text" id="{{uniqid}}-instruction-help">{{#str}} aiinstruction_help, gradingform_matrix {{/str}}</div>
                <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                    <button type="submit" class="btn btn-primary" data-action="ai-send">{{#str}} aisend, gradingform_matrix {{/str}}</button>
                    <button type="button" class="btn btn-outline-secondary" data-action="ai-reset">{{#str}} aistartagain, gradingform_matrix {{/str}}</button>
                    <span class="d-none" data-region="ai-busy">
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        {{#str}} aiworking, gradingform_matrix {{/str}}
                    </span>
                </div>
            </form>
        </div>
        <div class="col-lg-7">
            <h3 class="h6">{{#str}} aipreview, gradingform_matrix {{/str}}</h3>
            <div class="gradingform_matrix-ai-preview mb-3" data-region="ai-preview">
                <p class="small text-body-secondary">{{#str}} aipreviewempty, gradingform_matrix {{/str}}</p>
            </div>
            <button type="button" class="btn btn-primary" data-action="ai-apply" disabled>
                {{#str}} aiapply, gradingform_matrix {{/str}}
            </button>
            {{^canapply}}
            <p class="small text-danger mt-2">{{#str}} importerrorused, gradingform_matrix {{/str}}</p>
            {{/canapply}}
        </div>
    </div>
</div>
