{{!
    @template gradingform_matrix/options

    The grading form options, shown to people who can manage the form.

    Context variables required for this template:
    * items: list of options, each with
      * class
      * select: optional {id, label, menu} or {id, label, valuetext}, for a choice; menu is
        the context of gradingform_matrix/select
      * checkbox: optional {id, name, checked, disabled, label}, for a yes/no option
      * hidden: optional {name, id, value}, the value to submit while the option is frozen
      * helphtml: optional help icon

    Example context (json):
    {
        "items": [
            {"class": "option enableremarks",
                "checkbox": {"id": "advancedgrading-options-enableremarks",
                    "name": "advancedgrading[options][enableremarks]", "checked": true,
                    "label": "Allow grader to add text remarks for each criterion"} }
        ]
    }
}}
<div class="options">
    <div class="optionsheading">{{#str}} formoptions, gradingform_matrix {{/str}}</div>
    {{#items}}
        <div class="{{class}}">
            {{#select}}
                <label for="{{id}}">{{label}}</label>
                <span class="value">{{#menu}}{{> gradingform_matrix/select }}{{/menu}}{{^menu}}{{valuetext}}{{/menu}}</span>
                {{#hidden}}
                    <input name="{{name}}" id="{{id}}" type="hidden" value="{{value}}">
                {{/hidden}}
            {{/select}}
            {{#checkbox}}
                {{#hidden}}
                    <input name="{{name}}" id="{{id}}" type="hidden" value="{{value}}">
                {{/hidden}}
                <input{{#name}} name="{{.}}"{{/name}} id="{{id}}" type="checkbox" value="1"{{#checked}} checked="checked"{{/checked}}{{#disabled}} disabled="disabled"{{/disabled}}>
                <label for="{{id}}">{{label}}</label>
            {{/checkbox}}
            {{{helphtml}}}
        </div>
    {{/items}}
</div>
